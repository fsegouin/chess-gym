{
  "name": "chess-gym",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "engine": "node scripts/copy-engine.mjs",
    "dev": "node scripts/copy-engine.mjs && next dev",
    "build": "node scripts/copy-engine.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "broadcasts": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/broadcasts.mts"
  },
  "dependencies": {
    "ai": "^7.0.128",
    "chess.js": "^1.4.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stockfish": "^19.0.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.8.0"
}
